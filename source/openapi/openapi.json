  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Kunci member berprefix `rv_live_`. Alternatif: `Authorization: Bearer rv_live_...`."
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "description": "Nilai unik 8-200 karakter ASCII per operasi bisnis. Gunakan nilai yang sama saat retry request yang sama. Opsional — bila kosong, server membuatkan kunci unik otomatis dan mengembalikannya di header respons Idempotency-Key.",
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200,
          "pattern": "^[!-~]+$"
        },
        "example": "pay-ord-20261021-8a3c2f11"
      },
      "RequestId": {
        "name": "X-Request-ID",
        "in": "header",
        "required": false,
        "description": "Korelasi opsional dari klien; server selalu mengembalikan request ID pada respons.",
        "schema": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "service",
          "timestamp",
          "provider_mode"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "rajacek-api"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "provider_mode": {
            "type": "string",
            "enum": [
              "demo",
              "http"
            ]
          }
        }
      },
      "PublicProductStatus": {
        "type": "object",
        "required": [
          "product",
          "label",
          "status"
        ],
        "properties": {
          "product": {
            "type": "string",
            "enum": [
              "bank_account",
              "ewallet",
              "whatsapp",
              "pln"
            ]
          },
          "label": {
            "type": "string",
            "example": "Validasi Rekening"
          },
          "status": {
            "type": "string",
            "enum": [
              "operational",
              "degraded"
            ]
          }
        }
      },
      "PublicStatus": {
        "type": "object",
        "required": [
          "overall",
          "products",
          "maintenance_blocks_validations"
        ],
        "properties": {
          "overall": {
            "type": "string",
            "enum": [
              "operational",
              "degraded"
            ]
          },
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicProductStatus"
            }
          },
          "announcement": {
            "type": [
              "string",
              "null"
            ]
          },
          "maintenance_banner": {
            "type": [
              "string",
              "null"
            ]
          },
          "maintenance_blocks_validations": {
            "type": "boolean"
          }
        }
      },
      "BankCode": {
        "type": "object",
        "required": [
          "code_bank",
          "name_bank"
        ],
        "properties": {
          "code_bank": {
            "type": "string",
            "pattern": "^[0-9]{3}$",
            "example": "002"
          },
          "name_bank": {
            "type": "string",
            "example": "BRI"
          }
        }
      },
      "BankAccountValidationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bank_code",
          "account_number"
        ],
        "properties": {
          "bank_code": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "pattern": "^[0-9]{3}$",
            "description": "Kode bank resmi 3 digit dari GET /v1/banks.",
            "example": "014"
          },
          "account_number": {
            "type": "string",
            "minLength": 6,
            "maxLength": 32,
            "pattern": "^[0-9 -]+$",
            "example": "1234567890"
          }
        }
      },
      "EwalletValidationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "account_number"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "dana",
              "gopay",
              "gopay_driver",
              "ovo",
              "shopeepay",
              "linkaja",
              "astrapay",
              "isaku",
              "kaspro"
            ],
            "description": "Kode provider e-wallet publik.",
            "example": "gopay"
          },
          "account_number": {
            "type": "string",
            "minLength": 6,
            "maxLength": 32,
            "example": "081234567890"
          }
        }
      },
      "WhatsappValidationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phone_number"
        ],
        "properties": {
          "phone_number": {
            "type": "string",
            "description": "Nomor format internasional atau lokal Indonesia (08...).",
            "example": "+6281234567890"
          }
        }
      },
      "ValidationStatus": {
        "type": "string",
        "description": "Billing: valid dan not_kyc memotong 1 hit; invalid dan not_found (satu pool bersama) gratis hingga 100 per hari per kunci (WIB), selebihnya 1 hit; pending, provider_error, rate_limited, dan quota_exhausted tidak memotong dan tidak memakan jatah gratis. Kunci bersaldo 0 tetap ditolak 402 sebelum cek berjalan.",
        "enum": [
          "valid",
          "invalid",
          "not_found",
          "not_kyc",
          "pending",
          "provider_error",
          "rate_limited",
          "quota_exhausted"
        ]
      },
      "ValidationResult": {
        "type": "object",
        "properties": {
          "account_number": {
            "type": [
              "string",
              "null"
            ],
            "description": "Nomor rekening/e-wallet yang divalidasi (bank & e-wallet).",
            "example": "1234667890"
          },
          "phone_number": {
            "type": [
              "string",
              "null"
            ],
            "description": "Nomor WhatsApp yang divalidasi (layanan whatsapp).",
            "example": "6281234567890"
          },
          "service_code": {
            "type": [
              "string",
              "null"
            ],
            "description": "Kode layanan yang divalidasi (kode bank 3 digit, slug e-wallet, atau whatsapp).",
            "example": "014"
          },
          "bank_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Nama bank sesuai katalog (khusus layanan bank).",
            "example": "BCA"
          },
          "account_name": {
            "type": [
              "string",
              "null"
            ],
            "example": "NAMA PELANGGAN"
          },
          "tarif": {
            "type": [
              "string",
              "null"
            ],
            "description": "Tarif listrik pelanggan (khusus produk pln, hanya bila tersedia).",
            "example": "R1"
          },
          "daya": {
            "type": [
