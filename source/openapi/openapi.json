        "tags": [
          "Validation"
        ],
        "summary": "Validasi nomor WhatsApp",
        "description": "Memeriksa apakah nomor terdaftar di WhatsApp. Dilarang untuk spam, enumerasi massal, atau pengiriman OTP tanpa persetujuan pemilik nomor.\n\nScope kunci yang diperlukan: `validate:whatsapp` atau `validate:*`.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WhatsappValidationRequest"
              },
              "examples": {
                "indonesia": {
                  "value": {
                    "phone_number": "+6281234567890"
                  }
                }
              }
            }
          }
        },
        "responses": {
