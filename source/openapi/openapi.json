{
  "openapi": "3.1.0",
  "info": {
    "title": "Rajacek API — Dokumentasi Member",
    "version": "1.0.0",
    "description": "API validasi rekening bank, e-wallet, dan nomor WhatsApp Indonesia untuk member Rajacek.\n\n**Autentikasi:** semua endpoint validasi memerlukan header `X-API-Key: rv_live_...` (atau `Authorization: Bearer rv_live_...`). Jaga kerahasiaan kunci Anda; kunci hanya ditampilkan sekali saat dibuat.\n\n**Idempotency-Key dianjurkan** pada setiap POST validasi: nilai unik 8–200 karakter per operasi bisnis. Bila tidak dikirim atau kosong, server membuatkan kunci unik otomatis dan mengembalikannya di header respons `Idempotency-Key`. Mengirim ulang request yang sama dengan kunci yang sama akan memutar respons yang sama tanpa memotong kuota dua kali.\n\n**Kode bank selalu 3 digit** (mis. `002` BRI, `014` BCA) — ambil daftar lengkapnya dari `GET /v1/banks`. Kode internal provider tidak pernah dipakai di sisi member.\n\n**Hasil validasi** ada di field `status` pada respons 200: `valid`, `invalid`, `not_found`, atau `pending`. Error teknis memakai format `ApiError` dengan HTTP 4xx/5xx.\n\n**Rate limit** bawaan 60 request/menit per kunci (header `X-RateLimit-Remaining`/`X-RateLimit-Reset` dikembalikan); kuota paket berkurang hanya untuk hasil yang tertagih (`valid`, `invalid`, `not_found`)."
  },
  "servers": [
    {
      "url": "/",
      "description": "Server Rajacek ini"
    }
  ],
  "tags": [
    {
      "name": "Validation",
      "description": "Endpoint validasi untuk member"
    },
    {
      "name": "Reference",
      "description": "Data referensi publik"
    },
    {
      "name": "System",
      "description": "Status layanan"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Cek layanan hidup",
        "security": [],
        "responses": {
          "200": {
            "description": "Layanan hidup.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "tags": [
          "System"
        ],
        "security": [],
        "operationId": "getPublicStatusPage",
        "summary": "Halaman status layanan publik (HTML)",
        "description": "Halaman status tanpa login. Hanya label produk dan status agregat operational/degraded, plus banner aktif. Tidak menyebut nama, URL, atau kode provider upstream.",
        "responses": {
          "200": {
            "description": "Halaman status layanan.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "tags": [
          "System"
        ],
        "security": [],
        "operationId": "getPublicStatus",
        "summary": "Status layanan publik (JSON)",
        "description": "Data yang sama dengan GET /status, dalam JSON, tanpa login.",
        "responses": {
          "200": {
            "description": "Status agregat layanan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicStatus"
                }
              }
            }
          }
        }
      }
    },
    "/v1/banks": {
      "get": {
        "tags": [
          "Reference"
        ],
        "summary": "Daftar kode bank 3 digit",
        "security": [],
        "description": "Mengembalikan seluruh bank yang didukung beserta kode 3 digit resminya. Gunakan `code_bank` sebagai `bank_code` pada validasi rekening.",
        "responses": {
          "200": {
            "description": "Daftar bank.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BankCode"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/validate/bank-account": {
      "post": {
        "tags": [
          "Validation"
        ],
        "summary": "Validasi rekening bank",
        "description": "Memvalidasi nomor rekening dan mengembalikan nama pemilik terdaftar bila ditemukan.\n\nScope kunci yang diperlukan: `validate:bank_account` atau `validate:*`.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BankAccountValidationRequest"
              },
              "examples": {
                "bca": {
                  "value": {
                    "bank_code": "014",
                    "account_number": "1234567890"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validasi selesai diproses. Periksa field `status` untuk hasil bisnisnya.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Reset": {
                "schema": {
                  "type": "integer",
                  "description": "Detik sampai jendela limit berikutnya."
                }
              },
              "X-Idempotent-Replay": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                },
                "description": "Hadir hanya bila respons diputar dari idempotency cache."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Permintaan tidak memenuhi kontrak (field hilang/format salah/kode tidak dikenal).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "API key tidak ada, tidak valid, atau sudah dicabut.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "402": {
            "description": "Kuota paket habis.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Kunci tidak memiliki scope produk ini.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency-Key yang sama sedang diproses atau bertabrakan dengan payload berbeda.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit terlampaui atau antrean provider penuh. Tunggu sesuai `Retry-After`.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "Provider validasi mengembalikan respons yang tidak dapat diproses.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Provider sedang tidak tersedia (termasuk circuit breaker terbuka) atau endpoint belum dikonfigurasi.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
